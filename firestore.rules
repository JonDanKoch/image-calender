rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function approved() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function uploader() { return approved() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'uploader'; }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /calendarEntries/{entryId} {
      allow read: if approved();
      allow create: if uploader() && !exists(/databases/$(database)/documents/calendarEntries/$(entryId)) && request.resource.data.ownerId == request.auth.uid && request.resource.data.images.size() <= 10;
      allow update, delete: if uploader() && resource.data.ownerId == request.auth.uid && request.resource.data.images.size() <= 10;
    }
  }
}
