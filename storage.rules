rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function approved() { return request.auth != null && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)); }
    function uploader() { return approved() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'uploader'; }
    match /calendar/{entryId}/{fileName} {
      allow read: if approved();
      allow write: if uploader() && request.resource.contentType.matches('image/(jpeg|png)');
      allow delete: if uploader();
    }
  }
}
